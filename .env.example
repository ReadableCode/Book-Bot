# --- local dev (default): leave POSTGREST_URL unset -> SQLite in data/ ---
# SQLITE_PATH=data/book_bot.db
# GOOGLE_BOOKS_API_KEY=            # optional, raises rate limits

# --- production: shared PostgREST + postgrest-auth (load-log pattern) ---
# POSTGREST_URL=https://pgrest.tinkernet.me
# AUTH_URL=https://auth.tinkernet.me
# APP_SCHEMA=book_bot
# JWT_SECRET=                      # must equal POSTGREST_JWT_SECRET

# --- auth / signup / sample library ---
# SIGNUP_ENABLED=true              # false = invite-only (create_user.py)
# SAMPLE_BOOKS_PATH=app/sample_books.json
# SAMPLE_AUTOSTOCK=true            # false = never stock the sample shelf at startup

# --- for scripts/create_user.py AND /api/signup in production (superuser) ---
# POSTGRES_URL=
# POSTGRES_PORT=5432
# POSTGRES_DB=apps
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
