# --- self-contained stack (compose.yaml): only these three are needed ---
# letters and digits only (they go into a connection URL and SQL);
# generate each with `openssl rand -hex 32`
# POSTGRES_PASSWORD=
# POSTGREST_DB_PASSWORD=
# POSTGREST_JWT_SECRET=            # 32+ characters
# BOOK_BOT_PORT=8010

# --- running the app against an existing Postgres + PostgREST ---
# (compose.external.yaml, or uv run uvicorn as in the README)

# --- required: there is no local fallback store (conventions I8) ---
# a missing POSTGREST_URL or JWT_SECRET raises at import rather than
# quietly swapping backends. Local development points at the real
# deployment, same as the rest of the fleet.
# POSTGREST_URL=https://pgrest.tinkernet.me
# APP_SCHEMA=book_bot
# JWT_SECRET=                      # must equal POSTGREST_JWT_SECRET

# --- optional ---
# GOOGLE_BOOKS_API_KEY=            # raises metadata rate limits
# SIGNUP_ENABLED=true              # false = invite-only (create_user.py)

# --- superuser: schema bootstrap, login, /api/signup, and the account CLIs ---
# book_bot.users is unreachable through PostgREST by design, so these
# four paths connect to Postgres directly (conventions I2).
# POSTGRES_URL=
# POSTGRES_PORT=5432
# POSTGRES_DB=apps
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
